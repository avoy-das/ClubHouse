# PRODUCTION ENVIRONMENT -- REQUIRED OVERRIDES
# Copy this to .env on your production server and fill in real values.

APP_NAME=ClubHouse
APP_ENV=production
APP_KEY=  # Run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-production-domain.com

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clubhouse
DB_USERNAME=clubhouse_user  # Dedicated user, NOT root
DB_PASSWORD=                # Strong random password required

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=your-production-domain.com

SANCTUM_STATEFUL_DOMAINS=your-production-domain.com
CORS_ALLOWED_ORIGINS=https://your-production-domain.com
CORS_ALLOWED_PATTERNS=
